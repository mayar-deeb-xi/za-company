# The signaling service: any WebSocket upgrade, whatever its path, so the
# game still connects to plain wss://DOMAIN, plus its health check.
# Matched by regex because both headers are case-insensitive and clients
# disagree: Chrome sends "Upgrade", Node sends "upgrade", and the plain
# `header` matcher's wildcard sent the second one the game's index.html.
(signaling) {
	@signal {
		header_regexp Connection (?i)\bupgrade\b
		header_regexp Upgrade (?i)^websocket$
	}
	handle @signal {
		reverse_proxy 127.0.0.1:{$SIGNAL_PORT}
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:{$SIGNAL_PORT}
	}
}

# Everything else is a web build of the game (README.md, The web build).
# Every file keeps its name from build to build, so a browser must ask
# again each visit (no-cache revalidates by ETag; it does not mean no
# caching), or a new index.pck meets a stale index.wasm.
(game) {
	handle {
		root * {args[0]}
		header Cache-Control "no-cache"
		file_server {
			precompressed gzip
		}
	}
}

# The game: always the latest release.
{$SIGNAL_DOMAIN} {
	import signaling
	import game /srv/web/game
}

# The dev site: whatever the last dev deploy built from develop
# (RELEASING.md, Deploying to dev). Same signaling as the game - one service
# until a protocol change gives dev its own - and kept out of search results.
dev.{$SIGNAL_DOMAIN} {
	import signaling
	header X-Robots-Tag "noindex, nofollow"
	import game /srv/web/dev-game
}
