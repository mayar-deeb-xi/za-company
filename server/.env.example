# Copy to .env next to docker-compose.yml and fill in. .env is gitignored:
# TURN_SECRET must never be committed.

# The name players' games connect to: wss://DOMAIN for signaling, and
# DOMAIN:3478 for STUN/TURN. A subdomain of your own is the usual choice,
# with an A record pointing at this server.
DOMAIN=play.example.com

# This server's public IPv4. On a cloud VM whose interface holds a PRIVATE
# address (AWS, GCP, ...), write it as PUBLIC/PRIVATE, e.g. 203.0.113.10/10.0.0.5
EXTERNAL_IP=203.0.113.10

# Shared by coturn and the signaling service; generate with:
#   openssl rand -hex 32
TURN_SECRET=

# STUN/TURN listening port (UDP and TCP), and the UDP range relays come out of.
# One relayed player holds one port of the range, so 41 ports = ~40 at once.
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_TOTAL_QUOTA=40

# Where the signaling service listens on loopback for the TLS proxy.
SIGNAL_PORT=8765

# The most players any one room may hold, whatever a client asks for. The
# game's own MAX_PARTY decides the real size; this is only the safety cap.
PARTY_CEILING=8
